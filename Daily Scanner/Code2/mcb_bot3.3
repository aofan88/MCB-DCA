# ================= 數據管理 (Data Manager) =================

def load_data():
    """加載數據庫"""
    if not os.path.exists(DATA_FILE):
        return {"subscribers": [], "vip_users": [], "active_keys": {}}
    try:
        with open(DATA_FILE, 'r') as f:
            data = json.load(f)
            if isinstance(data, list): 
                return {"subscribers": data, "vip_users": [], "active_keys": {}}
            return data
    except Exception as e:
        logging.error(f"數據加載失敗: {e}")
        return {"subscribers": [], "vip_users": [], "active_keys": {}}

def save_data(data):
    """保存數據庫"""
    with open(DATA_FILE, 'w') as f:
        json.dump(data, f, indent=4)

def is_vip(user_id):
    """檢查 VIP 身份"""
    data = load_data()
    return user_id in data.get("vip_users", [])

def add_subscriber(user_id):
    data = load_data()
    if user_id not in data["subscribers"]:
        data["subscribers"].append(user_id)
        save_data(data)

def remove_subscriber(user_id):
    data = load_data()
    if user_id in data["subscribers"]:
        data["subscribers"].remove(user_id)
        save_data(data)

# ================= VIP 計算核心 =================

def calculate_vip_order(ticker, action_str):
    """計算下單金額: Base * Weight * Mult"""
    signal_mult = 2 if "2×" in action_str else 1
    info = ASSET_INFO.get(ticker, {'level': 'Unknown', 'weight': 1})
    weight = info['weight']
    level = info['level']
    final_amount = BASE_UNIT * weight * signal_mult
    return final_amount, level, weight, signal_mult

def format_vip_message(vip_pack):
    """生成 VIP 專屬詳細報告 (v3.3 最終版)"""
    today_list = vip_pack.get('today', [])
    recent_list = vip_pack.get('recent', [])
    
    if not today_list and not recent_list:
        return None

    current_date = datetime.now().strftime('%Y-%m-%d')
    msg = "👑 <b>RunSing VIP 執行指令</b>\n"
    msg += f"📅 {current_date}\n"
    msg += "━━━━━━━━━━━━━━━━━━\n"
    
    # --- 第一部分：今日信號 (TODAY) ---
    if today_list:
        msg += "\n🚨 <b>今日信號 (TODAY)</b>\n"
        for s in today_list:
            amount, level, weight, mult = calculate_vip_order(s['ticker'], s['action'])
            
            msg += f"🎯 <b>{s['ticker']}</b> ({level})\n"
            msg += f"💰 <b>買入: ${amount}</b>\n"
            # 修改點：改為「收盤價」
            msg += f"📊 收盤價: ${s['price']:.2f} | WT:{s['mcb_val']:.1f}\n"
            msg += "------------------\n"
    
    # --- 第二部分：近期補救 (RECENT) ---
    if recent_list:
        msg += "\n⏳ <b>近期漏單補救 (RECENT)</b>\n"
        msg += "<i>若之前漏操作，可參考以下：</i>\n"
        for s in recent_list:
            amount, level, _, _ = calculate_vip_order(s['ticker'], s['action'])
            # 格式：• 2025-12-24 AAPL: 需買 $80 (當時價 $273.81)
            msg += f"• {s['date']} <b>{s['ticker']}</b>: 需買 <b>${amount}</b>\n"
            msg += f"  (收盤價 ${s['price']:.2f})\n"

    msg += "━━━━━━━━━━━━━━━━━━\n"
    # 修改點：刪除了「今日需入金」統計行
    msg += f"🚀 請打開 {BROKER_NAME} 下單。"
    return msg

# ================= 核心掃描邏輯 =================

def calculate_mcb(df, n1=9, n2=12):
    """計算 MCB 技術指標"""
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.get_level_values(0)
    source = (df['High'] + df['Low'] + df['Close']) / 3
    esa = source.ewm(span=n1, adjust=False).mean() 
    d = (source - esa).abs().ewm(span=n1, adjust=False).mean()
    ci = (source - esa) / (0.015 * d.replace(0, 0.00001))
    wt1 = ci.ewm(span=n2, adjust=False).mean() 
    wt2 = wt1.rolling(window=3).mean()
    df['wt1'] = wt1; df['wt2'] = wt2
    return df

def run_scan_logic():
    """執行掃描 (v3.3 交易日邏輯版)"""
    all_signals = []
    
    for ticker in TICKERS:
        try:
            df = yf.download(ticker, period="6mo", interval="1d", progress=False, auto_adjust=False)
            if len(df) < 50: continue
            
            df = calculate_mcb(df, N1, N2)
            check_range = df.iloc[-(LOOKBACK_DAYS + 1):]
            
            for i in range(1, len(check_range)):
                curr = check_range.iloc[i]
                prev = check_range.iloc[i-1]
                if (prev['wt1'] < prev['wt2']) and (curr['wt1'] >= curr['wt2']):
                    val = curr['wt1']
                    action = ""
                    if val < LEVEL_2_BUY: action = "2× Buy"
                    elif val < LEVEL_1_BUY: action = "1× Buy"
                    
                    if action:
                        all_signals.append({
                            'ticker': ticker,
                            'date': curr.name.strftime('%Y-%m-%d'),
                            'price': curr['Close'],
                            'mcb_val': val,
                            'action': action
                        })
        except Exception:
            continue

    # --- 生成報告與分組邏輯 ---
    current_time_str = datetime.now().strftime('%Y-%m-%d %H:%M')
    public_report = f"📊 <b>RunSing</b>-MCB Scanner v3.3\n🕒 {current_time_str}\n\n"
    vip_signals_pack = {'today': [], 'recent': []}

    if not all_signals:
        public_report += "😴 <b>NO SIGNALS</b>\n近期無操作信號。"
        return public_report, vip_signals_pack

    all_signals.sort(key=lambda x: x['date'], reverse=True)
    
    # 🌟 邏輯修正：取數據源裡「最新的一個日期」作為 Today
    # 這樣週一掃描時，週五的信號就會是 Today
    latest_data_date = all_signals[0]['date']
    
    today_group = [s for s in all_signals if s['date'] == latest_data_date]
    past_group = [s for s in all_signals if s['date'] != latest_data_date]

    # 填充 VIP 數據包
    vip_signals_pack['today'] = today_group
    
    # VIP 回溯 (以最新交易日為基準，往前推 N 天)
    limit_date = (datetime.strptime(latest_data_date, '%Y-%m-%d') - timedelta(days=VIP_LOOKBACK_DAYS)).date()
    
    for s in past_group:
        if datetime.strptime(s['date'], '%Y-%m-%d').date() >= limit_date:
            vip_signals_pack['recent'].append(s)

    # --- 生成普通報告文本 ---
    
    # A. 最新信號 (詳細：含 WT)
    public_report += "━━━━━━━━━━━━━\n🔥 <b>NEW SIGNAL</b>\n━━━━━━━━━━━━━\n"
    for s in today_group:
        public_report += f"• <b>{s['ticker']}</b> — {s['action']}\n  Date: {s['date']}\n  Price: ${s['price']:.2f} | WT: {s['mcb_val']:.1f}\n\n"

    # B. 過去信號 (精簡：無 WT)
    if past_group:
        public_report += "━━━━━━━━━━━━━\n📅 <b>PAST SIGNALS</b>\n━━━━━━━━━━━━━\n"
        for date, group in groupby(past_group, key=lambda x: x['date']):
            public_report += f"{date}\n"
            for s in group:
                short_action = s['action'].split(' ')[0] # "1× Buy" -> "1×"
                public_report += f"• {s['ticker']} ({short_action}) @ ${s['price']:.2f}\n"
            public_report += "\n"
            
    public_report += "━━━━━━━━━━━━━\n🤖 價格僅供參考，VIP 請查看指令。"
    return public_report, vip_signals_pack

