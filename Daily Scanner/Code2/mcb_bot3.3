        parse_mode='Markdown'
    )

async def get_my_id(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(f"您的 ID: `{update.effective_chat.id}`", parse_mode='Markdown')

async def scan_now(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_chat.id
    if user_id in LAST_SCAN_TIME:
        diff = (datetime.now() - LAST_SCAN_TIME[user_id]).total_seconds()
        if diff < SCAN_COOLDOWN_SECONDS:
            await update.message.reply_text(f"⏳ 冷卻中... 請等待 {int(SCAN_COOLDOWN_SECONDS - diff)} 秒")
            return
    LAST_SCAN_TIME[user_id] = datetime.now()

    await update.message.reply_text("🔍 正在掃描全市場...")
    
    loop = asyncio.get_running_loop()
    public_msg, vip_pack = await loop.run_in_executor(None, run_scan_logic)

    if is_vip(user_id):
        await update.message.reply_text(public_msg, parse_mode='HTML')
        vip_msg = format_vip_message(vip_pack)
        if vip_msg:
            await update.message.reply_text(vip_msg, parse_mode='HTML')
        else:
            await update.message.reply_text("👑 VIP 提示：近期無新信號。", parse_mode='HTML')
    else:
        await update.message.reply_text(public_msg, parse_mode='HTML')
        if vip_pack['today'] or vip_pack['recent']:
             await update.message.reply_text("🔒 <b>VIP 內容已隱藏</b>\n輸入 /vip 獲取具體下單金額。", parse_mode='HTML')

# --- 卡密指令 ---
async def gen_key(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_chat.id != ADMIN_ID: return
    key = "VIP-" + secrets.token_hex(4).upper()
    data = load_data()
    data["active_keys"][key] = 365
    save_data(data)
    await update.message.reply_text(f"🔑 新卡密：\n`{key}`", parse_mode='Markdown')

async def redeem_vip(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try: key = context.args[0]
    except: 
        await update.message.reply_text("用法：`/vip 卡密`", parse_mode='Markdown')
        return
    data = load_data()
    if key in data["active_keys"]:
        if update.effective_chat.id not in data["vip_users"]:
            data["vip_users"].append(update.effective_chat.id)
        del data["active_keys"][key]
        save_data(data)
        await update.message.reply_text("🎉 **VIP 激活成功！**", parse_mode='Markdown')
    else:
        await update.message.reply_text("❌ 卡密無效")

# --- 定時任務函數 ---
async def daily_broadcast_morning(context: ContextTypes.DEFAULT_TYPE):
    logging.info("⏰ [06:00] 早報廣播...")
    data = load_data()
    if not data["subscribers"]: return
    loop = asyncio.get_running_loop()
    public_msg, vip_pack = await loop.run_in_executor(None, run_scan_logic)
    vip_msg = format_vip_message(vip_pack)

    for uid in data["subscribers"]:
        try:
            await context.bot.send_message(uid, public_msg, parse_mode='HTML', disable_web_page_preview=True)
            if is_vip(uid) and vip_msg:
                await context.bot.send_message(uid, vip_msg, parse_mode='HTML')
        except Exception as e:
            logging.error(f"早報失敗 {uid}: {e}")

async def vip_evening_reminder(context: ContextTypes.DEFAULT_TYPE):
    logging.info("⏰ [21:00] VIP 盤前提醒...")
    data = load_data()
    if not data["vip_users"]: return
    loop = asyncio.get_running_loop()
    _, vip_pack = await loop.run_in_executor(None, run_scan_logic)
    vip_msg = format_vip_message(vip_pack)
    
    if not vip_msg: return

    final_msg = "🔔 <b>美股盤前提醒 (21:00)</b>\n" + vip_msg
    for uid in data["vip_users"]:
        try:
            await context.bot.send_message(uid, final_msg, parse_mode='HTML')
        except Exception as e:
            logging.error(f"盤前失敗 {uid}: {e}")

